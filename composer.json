{
  "name": "acme/myapp",
  "type": "project",
  "require": { "php": "^8.5" },
  "autoload": {
    "psr-4": { "App\\": "app/" },
    "files": ["app/helpers.php"]
  },
  "autoload-dev": { "psr-4": { "Tests\\": "tests/" } },
  "config": { "optimize-autoloader": true, "sort-packages": true },
  "scripts": {
    "serve": ["Composer\\Config::disableProcessTimeout", "php -S 127.0.0.1:8000 -t public"],
    "test": "phpunit",
    "stan": "phpstan analyse app --level=8",
    "cs": "php-cs-fixer fix --dry-run --diff",
    "audit": "composer audit"
  }
}